generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  email          String
  status         OrderStatus @default(PENDING)
  totalCents     Int
  createdAt      DateTime    @default(now())
  idempotencyKey String?
  requestHash    String?
  createdById    String?
  createdBy      User?       @relation(fields: [createdById], references: [id])
  items          OrderItem[]

  @@unique([createdById, idempotencyKey])
  @@index([status])
  @@index([createdAt])
  @@index([totalCents])
  @@index([createdById])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  name           String
  quantity       Int
  unitPriceCents Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
